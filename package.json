{
  "name": "nexbuild",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:workload-auto": "node scripts/test-workload-auto-apply.mjs",
    "test:workload": "node scripts/test-workload-optimization.mjs",
    "test:accounts": "node scripts/test-accounts.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:server": "node scripts/dev.mjs --backend-only",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:pages": "run-p type-check build-only:pages",
    "build-only:pages": "vite build --mode pages",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:build-selection": "node scripts/test-build-selection.mjs",
    "test:optimization": "node scripts/test-build-optimization.mjs",
    "test:demand-weights": "node scripts/test-demand-weights.mjs",
    "test:theme": "node scripts/test-theme.mjs",
    "test:reference-prices": "node scripts/test-reference-prices.mjs",
    "test:candidates": "node scripts/test-candidates.mjs",
    "test:comparison-coverage": "node scripts/test-comparison-coverage.mjs",
    "audit:candidate-discovery": "node scripts/audit-candidate-discovery.mjs",
    "test:compatibility": "node scripts/test-compatibility.mjs",
    "test:site-access": "node scripts/test-site-access.mjs",
    "test:specifications": "node scripts/test-part-specifications.mjs",
    "test:part-comparison": "node scripts/test-part-comparison.mjs",
    "test:intel-platform": "node scripts/test-intel-platform.mjs",
    "audit:specifications": "node scripts/audit-specifications.mjs",
    "audit:secrets": "python server/scripts/security_audit.py --history",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "three": "^0.187.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "postcss": "^8.5.29",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
