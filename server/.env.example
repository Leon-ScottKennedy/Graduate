# Backend only. Never copy these values into the Vue environment.
JD_APP_KEY=
JD_APP_SECRET=
# Leave unset to use server/storage/nexbuild.sqlite3.
# NEXBUILD_DATABASE_PATH=storage/nexbuild.sqlite3

# Doubao (Volcengine Ark): enable the console's free-trial-only mode.
# ARK_MODEL: copy an enabled model ID or inference endpoint ID from the console.
ARK_API_KEY=
ARK_MODEL=

# Taobao Union: backend only. App Key / App Secret from your Taobao application.
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
# Your own full mm_xxx_xxx_xxx PID or its final numeric segment; never AppKey.
TAOBAO_ADZONE_ID=

# Local default only. Development mode rejects non-loopback clients.
NEXBUILD_ENV=development
# Production requires two DIFFERENT randomly generated values. Keep them backend-only.
# Generate each locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXBUILD_ACCESS_CODE=
NEXBUILD_ADMIN_TOKEN=
# Comma-separated exact HTTPS origins, no trailing slash or repository path.
# NEXBUILD_ALLOWED_ORIGINS=https://leon-scottkennedy.github.io
# Backend hostnames only, no schemes, paths, ports or wildcards.
# NEXBUILD_ALLOWED_HOSTS=your-backend.example.com
NEXBUILD_SESSION_TTL=3600
NEXBUILD_API_PER_MINUTE=120
NEXBUILD_AI_PER_MINUTE=3
# UTC daily quota for actual upstream AI calls (including refinements/failures).
NEXBUILD_AI_DAILY_LIMIT=100
# Daily collection requests AND actual upstream JD/Taobao calls are bounded separately.
NEXBUILD_COLLECTION_DAILY_LIMIT=50
NEXBUILD_MAX_REQUEST_BYTES=1048576

# Email verification: use an existing QQ/163 mailbox SMTP authorization code.
# No paid email API or domain is required. Never use your mailbox login password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USER. Must be an authorized sender.
SMTP_FROM=
