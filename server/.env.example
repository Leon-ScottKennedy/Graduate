# Backend only. Never copy these values into the Vue environment.
JD_APP_KEY=
JD_APP_SECRET=
# Leave unset to use server/storage/nexbuild.sqlite3.
# NEXBUILD_DATABASE_PATH=storage/nexbuild.sqlite3

# Doubao (Volcengine Ark): enable the console's free-trial-only mode.
# ARK_MODEL: copy an enabled model ID or inference endpoint ID from the console.
ARK_API_KEY=
ARK_MODEL=

# Taobao Union: backend only. App Key / App Secret from your Taobao application.
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
# Your own full mm_xxx_xxx_xxx PID or its final numeric segment; never AppKey.
TAOBAO_ADZONE_ID=
